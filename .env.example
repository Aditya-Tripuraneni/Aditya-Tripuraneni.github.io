# Server (Vercel env vars, or .env.local for local dev). Never commit real values.
DISCORD_WEBHOOK_URL=
# Optional: raises ipinfo.io rate limits
IPINFO_TOKEN=
# Optional: extra allowed origins for /api/visit, comma-separated
ALLOWED_ORIGIN=

# Client: only needed if the site is NOT served from the same host as /api (e.g. GitHub Pages)
VITE_VISIT_ENDPOINT=
